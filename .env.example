# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Supabase project URL and publishable (anon) key:
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: extra origins allowed to load the dev server (comma-separated),
# e.g. your phone on the same Wi-Fi. Leave empty if you don't need it.
NEXT_ALLOWED_DEV_ORIGINS=
